{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "node16",
    "module": "node16",
    "noEmit": true,
    "incremental": null,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "paths": {
      "@miraiui-org/theme": ["./node_modules/@miraiui-org/theme/src/index.ts"],
      "@miraiui-org/theme/*": ["./node_modules/@miraiui-org/theme/src/*"],
      "@miraiui-org/internal-utils": ["../utils/internal/src/index.ts"],
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "vite.config.ts", "uno.config.ts"]
}