{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": ["DOM","DOM.Iterable","ES2020"],
    "declaration": true,
    "sourceMap": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "isolatedModules": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "downlevelIteration": true,
    "noImplicitAny": false,
    "paths": {
      "@miraiui-org/theme": ["./packages/theme/src/index.ts"],
      "@miraiui-org/internal-utils": ["./packages/utils/internal/src/index.ts"],
    }
  },
  "include": ["packages/**/*", "uno.config.ts"],
  "exclude": ["**/node_modules", "**/dist"]
}