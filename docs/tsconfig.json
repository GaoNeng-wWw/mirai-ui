{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "paths": {
       "@miraiui-org/theme": ["../packages/theme/src"],
       "@miraiui-org/vue-core": ["../packages/core/src"],
       "@miraiui-org/vue-*": ["../packages/components/*/src"],
       "@miraiui-org/internal-utils": ["../packages/utils/internal/src/index.ts"]
    },
    "baseUrl": "."
  },
  "include": [
    "./**/*.ts",
    "./**/*.vue",
    ".vitepress/**/*.ts",
    ".vitepress/**/*.vue",
    ".vitepress/**/*.mts",
    "../packages/vue-components/**/*",
    "../packages/theme/**/*",
    "./docs/components/**/*.md",
    "tailwind.config.ts"
  ],
}